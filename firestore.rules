rules_version = '2';

// CS Interactive Workshop - Firestore security rules.
// Each student owns exactly one document, users/{uid}, holding their display
// name, photo and progress. Nobody can read or write anyone else's data, and
// every other collection is closed. Deploy with:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validUser(data) {
      return data.keys().hasOnly(['name', 'photoURL', 'progress', 'createdAt', 'updatedAt'])
        && (!('name' in data) || (data.name is string && data.name.size() <= 120))
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048))
        && (!('progress' in data) || data.progress is map)
        && (!('createdAt' in data) || data.createdAt is number)
        && (!('updatedAt' in data) || data.updatedAt is number);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUser(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
